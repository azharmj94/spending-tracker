rules_version = '2';
// Firestore's equivalent of Row Level Security (RLS).
// Each signed-in user can read and write only their own documents at users/<their uid>/docs/*.
// Everything else in the database is closed by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/docs/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
